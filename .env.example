# Copy to .env (copy .env.example .env) and adjust if needed. Every setting in app/config.py can be set here.

# ---- LLM: local Ollama (no API key, nothing leaves your machine) ----
# One-time setup: install Ollama from https://ollama.com, then:  ollama pull gpt-oss:20b
# Needs a GPU with ~16 GB memory. Check the setup with:  python -m scripts.check_llm
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:20b
# LLM_BASE_URL=http://localhost:11434/v1   # default; change only if Ollama runs on another machine/port
# OLLAMA_NUM_CTX=16384                     # context window sent with every request
# OLLAMA_KEEP_ALIVE=30m                    # how long the model stays loaded between questions

# ---- Optional, not needed: a hosted OpenAI-compatible API instead of Ollama (disabled) ----
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key
# LLM_MODEL=openai/gpt-oss-120b

# ---- Elasticsearch (docker compose up -d elasticsearch) ----
ES_URL=http://localhost:9200
ES_INDEX=chunks

# ---- Storage: SQLite database and uploaded files ----
DATA_DIR=data

# ---- OCR ----
# Windows: full path to tesseract.exe if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_CONF_THRESHOLD=80

# ---- Retrieval / agent ----
RELEVANCE_FLOOR=0.03       # re-calibrate with: python -m scripts.eval_retrieval
MAX_STEPS=12

# Hugging Face model cache (BGE models, ~1.5 GB). Set it as a real environment variable, not only here,
# because sentence-transformers reads it directly. PowerShell:  setx HF_HOME "D:\path\to\.hf-cache"
